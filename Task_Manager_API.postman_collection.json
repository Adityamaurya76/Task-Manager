{
	"info": {
		"_postman_id": "a91b32d4-1234-4567-89ab-cdef01234567",
		"name": "Task Management API",
		"description": "Postman collection for Task Management System REST API (Laravel 12 + Sanctum).\n\n### How to use:\n1. Run `php artisan serve` (default: http://127.0.0.1:8000)\n2. Send **Login (Admin)** or **Login (Employee)** request — the auth `token` will be saved automatically into collection variables.\n3. Send any task requests with the token.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) {",
									"        pm.collectionVariables.set('token', json.token);",
									"        console.log('Saved token:', json.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"Admin@12345\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Authenticates as Admin and saves token into collection variable `token` automatically."
					},
					"response": []
				},
				{
					"name": "2. Login (Employee)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) {",
									"        pm.collectionVariables.set('token', json.token);",
									"        console.log('Saved employee token:', json.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"employee@example.com\",\n    \"password\": \"Employee@12345\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Authenticates as Employee and saves token into collection variable `token` automatically."
					},
					"response": []
				},
				{
					"name": "3. Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"logout"
							]
						},
						"description": "Revokes current Sanctum bearer token."
					},
					"response": []
				}
			]
		},
		{
			"name": "Tasks",
			"item": [
				{
					"name": "1. Get All Tasks",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/tasks",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tasks"
							]
						},
						"description": "List tasks. If authenticated as Admin, returns all tasks. If authenticated as Employee, returns only assigned tasks."
					},
					"response": []
				},
				{
					"name": "2. Filter Tasks by Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/tasks?status=pending",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tasks"
							],
							"query": [
								{
									"key": "status",
									"value": "pending",
									"description": "Options: pending, in_progress, completed"
								}
							]
						},
						"description": "Filter tasks by status (pending, in_progress, completed)."
					},
					"response": []
				},
				{
					"name": "3. Get Task Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/tasks/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tasks",
								"1"
							]
						},
						"description": "Fetch details of task #1. Accessible by Admin or the assigned Employee."
					},
					"response": []
				},
				{
					"name": "4. Update Task Status",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"in_progress\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/tasks/1/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tasks",
								"1",
								"status"
							]
						},
						"description": "Update task status to pending, in_progress, or completed. Accessible by Admin or the assigned Employee."
					},
					"response": []
				},
				{
					"name": "5. Test Unauthorized Access (403 Expected)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/tasks/999",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tasks",
								"999"
							]
						},
						"description": "Demonstrates security & authorization handling for non-existent or foreign tasks."
					},
					"response": []
				}
			]
		}
	]
}
